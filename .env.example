# Kifeh كيفاه — variables d'environnement
# Copiez ce fichier en `.env` (jamais commité) ou renseignez ces variables
# dans votre hébergeur. TOUT fonctionne sans configuration en développement.

# ── Base ─────────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production
# DB_PATH=/var/data/incidents.db        # auto-détecté si /var/data existe
# UPLOADS_DIR=/var/data/uploads
# BASE_URL=https://www.kifeh.org        # sinon détectée automatiquement
# CANONICAL_HOST=www.kifeh.org          # redirige les autres domaines (301)

# ── Secrets (OBLIGATOIRES en production — openssl rand -hex 32) ──────────────
SECRET_ENCRYPTION_KEY=
SECRET_HMAC_KEY=
SECRET_COOKIE_KEY=

# ── Administration ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Vérification des déclarants (OTP) ────────────────────────────────────────
# VERIFICATION_REQUIRED=0               # 0 = publication directe sans OTP
# NOTIFIER_DRIVER=dev                   # dev | twilio | smtp
# TWILIO_SID=  TWILIO_TOKEN=  TWILIO_FROM=
# SMTP_HOST=  SMTP_PORT=  SMTP_USER=  SMTP_PASS=  SMTP_FROM=

# ── NASA FIRMS (détections satellitaires d'incendies) ────────────────────────
# Clé gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=

# ── Divers ───────────────────────────────────────────────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX        # Google Analytics 4 (facultatif)
# SANDBOX_ENABLED=1                     # environnement de test /sandbox
# Tout réglage de `defaultSettings` (src/config.js) est aussi surchargeable
# par variable d'environnement en MAJUSCULES (ex. FIRMS_SYNC_INTERVAL_MIN=15).
