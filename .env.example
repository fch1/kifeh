# Kifeh كيفاه — variables d'environnement
# Copiez ce fichier en `.env` (jamais commité) ou renseignez ces variables
# dans votre hébergeur. TOUT fonctionne sans configuration en développement.

# ── Base ─────────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production
# DB_PATH=/var/data/incidents.db        # auto-détecté si /var/data existe
# UPLOADS_DIR=/var/data/uploads
# BASE_URL=https://kifeh.app            # sinon détectée automatiquement
# CANONICAL_HOST=kifeh.app             # redirige les autres domaines (301)

# ── Secrets (OBLIGATOIRES en production — openssl rand -hex 32) ──────────────
SECRET_ENCRYPTION_KEY=
SECRET_HMAC_KEY=
SECRET_COOKIE_KEY=

# ── Administration ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Vérification des déclarants (OTP) ────────────────────────────────────────
# VERIFICATION_REQUIRED=0               # 0 = publication directe sans OTP
# NOTIFIER_DRIVER=dev                   # dev | twilio | smtp
# TWILIO_SID=  TWILIO_TOKEN=  TWILIO_FROM=
# SMTP_HOST=  SMTP_PORT=  SMTP_USER=  SMTP_PASS=  SMTP_FROM=

# ── NASA FIRMS (détections satellitaires d'incendies) ────────────────────────
# Clé gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=

# ── Divers ───────────────────────────────────────────────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX        # Google Analytics 4 (facultatif)
# SANDBOX_ENABLED=1                     # environnement de test /sandbox
# Tout réglage de `defaultSettings` (src/config.js) est aussi surchargeable
# par variable d'environnement en MAJUSCULES (ex. FIRMS_SYNC_INTERVAL_MIN=15).

# ── Sauvegarde hors-site (facultative, gratuite) ─────────────────────────────
# Copie quotidienne CHIFFRÉE de la base vers un dépôt GitHub privé.
# Jeton « fine-grained » limité au dépôt privé, permission Contents: write.
# GITHUB_BACKUP_TOKEN=github_pat_...
# GITHUB_BACKUP_REPO=fch1/Kifeh-private

# ── Domaine canonique ────────────────────────────────────────────────────────
# kifeh.app par défaut en production ; autre domaine, ou « off » pour couper.
# CANONICAL_HOST=kifeh.app

# ── Issues de secours ────────────────────────────────────────────────────────
# ADMIN_TOTP_RESET=1   # désactive la double authentification admin au démarrage
# WEB_PUSH_DISABLED=1  # coupe l'envoi des alertes de zone (tests)

# ── Vigilance Météo-France (facultative — expérience France) ─────────────────
# Clé API du portail portail-api.meteofrance.fr (souscription
# « DonnéesPubliquesVigilance »). Les vigilances orange/rouge du jour
# deviennent des informations officielles, par département.
# METEOFRANCE_API_KEY=eyJ4NXQi...
